[Unit]
Description=AIGC Studio web application (FastAPI)
After=network.target

[Service]
Type=simple
User=aigc
Group=aigc
WorkingDirectory=/opt/aigc-studio
EnvironmentFile=/etc/aigc-studio/environment
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/aigc-studio/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 3000 --workers 1
Restart=on-failure
RestartSec=3
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/aigc-studio
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=true

[Install]
WantedBy=multi-user.target
