[Unit]
Description=AIGC Studio poll one external generation task
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aigc
Group=aigc
WorkingDirectory=/opt/aigc-studio
EnvironmentFile=/etc/aigc-studio/environment
ExecStart=/usr/bin/curl --fail --silent --show-error -X POST http://127.0.0.1:3000/api/internal/poll
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/aigc-studio /opt/aigc-studio/data
